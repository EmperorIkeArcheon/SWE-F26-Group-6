# Clerk publishable key (safe to expose in the browser). Use the SAME Clerk application
# as CLERK_PUBLISHABLE_KEY in server/.env. Leave empty to run the public demo with no sign-in.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: where the Express API lives. Defaults to /api, which Vite proxies to http://localhost:3000.
# VITE_API_URL=http://localhost:3000
